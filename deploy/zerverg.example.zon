// Copy to /etc/zerverg/zerverg.zon. Every field is optional; the
// values below are the defaults unless noted.
.{
    .listen_address = "0.0.0.0",
    .http_port = 7080, // the public site
    .https_port = 7443, // the site, when .tls = true
    .data_dir = "/var/lib/zerverg",

    // Admin console. Its own port = its own browser origin, so site
    // snippets can never use a console session. Keep it off the
    // internet: forward only the site port. null = listen_address.
    .admin_listen_address = null,
    .admin_port = 9080,

    // .password (default), .oauth or .proxy. With .oauth/.proxy
    // password login is disabled entirely.
    .auth_method = .password,
    .admin_user = "admin",
    // Optional. Empty: the password is managed from the console and
    // starts as "admin" (a change is forced on first login). Set it to
    // pin the password from config instead:
    //   printf '%s\n' 'your password' | zerverg hash-password
    // or pass it via the ZERVERG_ADMIN_PASSWORD_HASH env variable.
    .admin_password_hash = "",

    // .oauth: "Sign in with Google / GitHub / any OpenID provider".
    // Register an OAuth app with each provider using the callback
    //   <admin_public_url>/api/v1/auth/oauth/<name>/callback
    // allowed_users is REQUIRED: without it anyone with an account at
    // the provider could log in. Google/OIDC match *verified* e-mails
    // (or "sub:<id>"); GitHub matches "id:<numeric id>" (recommended,
    // see https://api.github.com/users/<login>) or the login name.
    // .admin_public_url = "https://admin.example.com",
    // .oauth_providers = .{
    //     .{
    //         .name = "google",
    //         .kind = .google,
    //         .label = "Google",
    //         .client_id = "1234-abc.apps.googleusercontent.com",
    //         .client_secret_env = "ZERVERG_GOOGLE_SECRET",
    //         .allowed_users = .{"me@gmail.com"},
    //     },
    //     .{
    //         .name = "github",
    //         .kind = .github,
    //         .label = "GitHub",
    //         .client_id = "Ov23li...",
    //         .client_secret_env = "ZERVERG_GITHUB_SECRET",
    //         .allowed_users = .{"id:583231"},
    //     },
    //     // Any OpenID Connect provider (GitLab, Keycloak, Authentik):
    //     // .{ .name = "sso", .kind = .oidc,
    //     //    .issuer = "https://sso.example.com/realms/home", ... },
    // },

    // .proxy: an authenticating reverse proxy sets a user header.
    // .proxy_user_header = "x-forwarded-user",
    // .trusted_proxies = .{"127.0.0.1"},
    // .proxy_allowed_users = .{"me"},
    .session_ttl_s = 28800,
    .login_max_failures = 5,
    .login_lockout_s = 900,

    // Body sizes. max_body_bytes is the hard ceiling: the per-type
    // limits must not exceed it.
    .max_body_bytes = 134217728, // 128 MiB
    .max_text_upload_bytes = 4194304, // posts, layouts, styles, snippets
    .max_image_bytes = 20971520,
    .max_video_bytes = 134217728,
    .max_media_total_bytes = 2147483648,
    .history_keep = 10, // versions kept per layout/style/snippet

    // Connection and request limits. Behind a reverse proxy every
    // client shares the proxy's IP: raise the per-IP values or set
    // rate_limit_per_s = 0.
    .max_connections = 256,
    .max_connections_per_ip = 16,
    .max_requests_per_connection = 1000,
    .connection_timeout_s = 60,
    .rate_limit_per_s = 20,
    .rate_limit_burst = 120,

    // Native TLS (TLS 1.3). The site moves to https_port, the console
    // uses TLS on admin_port, and http_port only redirects to HTTPS.
    // Implies .https = true. Both files empty: a local certificate
    // authority in <data_dir>/tls/ signs a server certificate on each
    // start; trust its ca.crt once (see README). Certificates are
    // read at startup; restart after renewing. Env overrides:
    // ZERVERG_TLS_CERT, ZERVERG_TLS_KEY.
    .tls = false,
    // Local CA only: extra names/IPs for the server certificate.
    // .tls_hosts = .{ "staging.lan", "192.168.1.20" },
    // .tls_cert_file = "/etc/letsencrypt/live/example.com/fullchain.pem",
    // .tls_key_file = "/etc/letsencrypt/live/example.com/privkey.pem",

    // Set to true when the site is reached over HTTPS through a
    // TLS-terminating proxy: enables HSTS and Secure cookies.
    .https = false,

    // Content-Security-Policy for public pages. The default only
    // allows scripts from this site (snippets).
    // .public_csp = "default-src 'self'; ...",
}
